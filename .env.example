# Gemini API Configuration (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Channel: 'whatsapp', 'telegram', or 'both'
NOTIFICATION_CHANNEL=whatsapp

# Recipient Phone Number (For WhatsApp, with country code, e.g. +1234567890 or +919876543210)
WHATSAPP_PHONE=+1234567890

# ==============================================================================
# WHATSAPP PROVIDER OPTIONS (Choose ONE of Option A, B, or C)
# ==============================================================================

# OPTION A: Twilio WhatsApp Sandbox (Easiest, Free & Highly Reliable)
# Sign up at https://www.twilio.com/ -> Messaging -> WhatsApp Sandbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# OPTION B: Green API (Free Developer Tier - Direct WhatsApp Messaging)
# Sign up at https://green-api.com/ -> Create free developer instance
# GREEN_API_INSTANCE_ID=your_instance_id_here
# GREEN_API_TOKEN=your_api_token_here

# OPTION C: Meta WhatsApp Cloud API (Official Meta Developer)
# Set up at https://developers.facebook.com/
# META_WA_ACCESS_TOKEN=your_meta_access_token_here
# META_WA_PHONE_NUMBER_ID=your_phone_number_id_here

# ==============================================================================
# TELEGRAM NOTIFICATIONS (Optional alternative)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# User Preferences
# ==============================================================================
USER_CITY=New York
USER_NAME=Alex
FOCUS_TOPICS=AI & Machine Learning, Tech Startups, Global Markets, Cybersecurity

